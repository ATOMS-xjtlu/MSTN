parm complex-amber.top
trajin md-1us.trj

autoimage
center :1-217 mass

rms first @CA
atomicfluct first @CA

trajout md-1us.xtc

# trajout md-12480-fix.pdb onlyframes 12480-12480
# trajout md-12490-fix.pdb onlyframes 12490-12490
# trajout md-12500-fix.pdb onlyframes 12500-12500
trajout md-25000-fix.pdb onlyframes 25000-25000
# atomicfluct out rmsf-protein.dat :1-217@CA byres # RMSF
# atomicfluct out rmsf-lig.dat lig :219&!@H= byres



run                                                        
