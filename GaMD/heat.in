heat: heat the system
&cntrl
 imin=0,                                  ! imin=0(default):run MD simulation
 ntx=1,
 irest=0,
 nstlim=70000,  dt=0.002,
 ntc=2, ntf=2,
 cut=10.0,
 ntb=1,
 ntpr=1000,
 ntwx=1000,
 ntwr = 1000
 ntt=3, gamma_ln=1.0,
 tempi=0.0, temp0=310.0,
 ntr=1, restraintmask='(!(:WAT|:MG|:CAL|:Na+|:Cl-) & !@H=) | (@KA,MG) | (:568@O)',
 restraint_wt=10.0,                       !
 nmropt=1                                 !nmropt=1: NMR restraints and weight changes will be read.
/                                         

   &wt TYPE='TEMP0', istep1=0, istep2=40000
   value1=0.1, value2=300.0, /
   &wt TYPE='END' /

