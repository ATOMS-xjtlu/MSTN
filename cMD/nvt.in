equil: NVT 400 ps 
&cntrl
 imin=0,                                  ! imin=0(default):run MD simulation
 ntx=5,
 irest=1,
 nstlim=400000, dt=0.002,
 ntc=2, ntf=2,
 ntpr=1000, ntwx=1000,ntwr = 2000
 cut=10.0,
 ntb=1,
 ntt=3, gamma_ln=1.0,
 tempi = 310.0, temp0=310.0,
 ntr=1, restraintmask='(!(:WAT|:MG|:CAL|:Na+|:Cl-) & !@H=) | (@KA,MG) | (:568@O)',
 restraint_wt=10.0,
 iwrap=1,
 ioutfm=1
/
  
