min1: minimize ions and solvation(50)
&cntrl
  imin=1,
  ntmin = 1
  maxcyc=10000,
  ncyc=1000,
  drms = 0.0001
  cut=10.0,
  ntb=1,
  ntpr=500,
  ntwx = 1000,
  ntr=1,
